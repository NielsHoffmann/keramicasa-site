---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Fetch all 4 gallery collections from src/content/galleries/
const galleries = await getCollection('galleries');
console.log('Gevonden galerieën:', galleries);
---

<BaseLayout title="Foto's">
  <h1>Fotogalerij</h1>
  <p>Klik op een van de onderstaande foto's om de collectie te bekijken:</p>

  <div class="category-grid">
    {galleries.map((gallery) => (
      <a href={`/fotos/${gallery.id}`} class="category-card">
        <div class="card-image-wrapper">
          <img src={gallery.data.coverImage} alt={gallery.data.title} />
        </div>
        <div class="card-info">
          <h2>{gallery.data.title}</h2>
          <span class="photo-count">{gallery.data.images.length} foto's &rarr;</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 25px;
  }

  .category-card {
    background-color: #1a1a1a;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    border-color: #ffffff;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .card-info {
    padding: 15px;
    text-align: center;
  }

  .card-info h2 {
    font-size: 1.2rem;
    color: #ffffff;
    margin-bottom: 5px;
  }

  .photo-count {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>