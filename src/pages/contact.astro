---
import BaseLayout from '../layouts/BaseLayout.astro';

// De 7 originele links van keramicasa.nl
const externalLinks = [
  {
    title: "SKNH",
    description: "Stichting Keramisten Noord-Holland",
    url: "http://www.keramisten-noordholland.nl"
  },
  {
    title: "Klei Magazine",
    description: "Tijdschrift over keramiek en kleikunst",
    url: "http://www.klei.nl/"
  },
  {
    title: "Galerie Terra Delft",
    description: "Galerie gespecialiseerd in hedendaagse keramiek",
    url: "http://www.terra-delft.nl"
  },
  {
    title: "Keramikos",
    description: "Leverancier van klei, grondstoffen en benodigdheden",
    url: "https://www.keramikos.nl/"
  },
  {
    title: "Judith de Vries",
    description: "Keramisch kunstenares en docente",
    url: "http://www.judithdevries.com/"
  },
  {
    title: "Jannie van der Wel",
    description: "Keramiste",
    url: "http://www.jannievanderwel.nl/"
  },
  {
    title: "SBB Gouda",
    description: "Nederlandse Keramiekopleiding",
    url: "https://keramiekopleiding.nl/"
  }
];
---

<BaseLayout title="Contact en info">
  <article class="contact-container">
    <h1>Contact en Info</h1>

    <!-- Contact & Formulier Raster -->
    <div class="contact-grid">
      <!-- Contact & Atelier Informatie -->
      <section class="info-card">
        <h2>Atelier KerAmiCasa</h2>
        <p class="author">Marianne Hoffmann</p>
        
        <div class="info-group">
          <strong>Adres / Locatie:</strong>
          <p>Heiloo, Noord-Holland</p>
        </div>

        <div class="info-group">
          <strong>E-mail:</strong>
          <p><a href="mailto:info@keramicasa.nl">info@keramicasa.nl</a></p>
        </div>

        
      </section>

      <!-- Contactformulier -->
      <section class="form-card">
        <h2>Stuur een bericht</h2>
        <form action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST" class="contact-form">
          <div class="form-group">
            <label for="name">Naam *</label>
            <input type="text" id="name" name="name" required placeholder="Uw naam" />
          </div>

          <div class="form-group">
            <label for="email">E-mailadres *</label>
            <input type="email" id="email" name="email" required placeholder="uw@email.nl" />
          </div>

          <div class="form-group">
            <label for="subject">Onderwerp</label>
            <input type="text" id="subject" name="subject" placeholder="Bijv. Vraag over vaasobject" />
          </div>

          <div class="form-group">
            <label for="message">Bericht *</label>
            <textarea id="message" name="message" rows="5" required placeholder="Uw bericht..."></textarea>
          </div>

          <button type="submit" class="submit-btn">Versturen</button>
        </form>
      </section>
    </div>

    <!-- Onderste rij: De 7 Originele Externe Links -->
    <section class="links-section">
      <h2>Links</h2>

      <div class="links-grid">
        {externalLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card">
            <div class="link-title">
              {link.title} <span class="external-icon">&nearr;</span>
            </div>
            <p class="link-desc">{link.description}</p>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .contact-container {
    max-width: 840px;
    margin: 0 auto;
  }

  h1 {
    font-size: 1.5rem;
    color: var(--heading-color, #ffffff);
    margin-bottom: 25px;
    font-weight: 400;
    border-bottom: 1px solid var(--border-color, #333333);
    padding-bottom: 10px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    margin-bottom: 35px;
  }

  h2 {
    font-size: 1.2rem;
    color: #66b2ff;
    margin-bottom: 15px;
    font-weight: 400;
  }

  .author {
    font-size: 1.1rem;
    color: #ffffff;
    font-weight: 600;
    margin-bottom: 15px;
  }

  .info-card, .form-card {
    background-color: #141414;
    border: 1px solid var(--border-color, #333333);
    border-radius: 6px;
    padding: 20px;
  }

  .info-group {
    margin-bottom: 14px;
  }

  .info-group strong {
    color: #ffffff;
    display: block;
    font-size: 0.88rem;
    margin-bottom: 2px;
  }

  .info-group p {
    margin: 0;
    color: var(--text-color, #dddddd);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .info-group a {
    color: #66b2ff;
    text-decoration: none;
  }

  .info-group a:hover {
    text-decoration: underline;
  }

  /* Formulier Styling */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-group label {
    font-size: 0.85rem;
    color: #ffffff;
  }

  .form-group input,
  .form-group textarea {
    background-color: #1f1f1f;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
    padding: 8px 10px;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.9rem;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #66b2ff;
  }

  .submit-btn {
    background-color: #2b4c7e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
    margin-top: 5px;
  }

  .submit-btn:hover {
    background-color: #3b66a6;
  }

  /* Links Sectie Styling */
  .links-section {
    border-top: 1px solid var(--border-color, #333333);
    padding-top: 25px;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .link-card {
    background-color: #141414;
    border: 1px solid var(--border-color, #333333);
    border-radius: 6px;
    padding: 15px;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .link-card:hover {
    border-color: #66b2ff;
    background-color: #1a1a1a;
  }

  .link-title {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.98rem;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .external-icon {
    color: #66b2ff;
    font-size: 0.85rem;
  }

  .link-desc {
    color: var(--text-color, #bbbbbb);
    font-size: 0.83rem;
    margin: 0;
    line-height: 1.35;
  }

  @media (max-width: 680px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>