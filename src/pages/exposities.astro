---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Exposities">
  <article class="exposities-container">
    <h1>Exposities en Activiteiten</h1>

    <section class="section">
      <h2>Deelname aan exposities in 2026</h2>
      <ul class="timeline">
        <li class="timeline-item highlight">
          <span class="date">7, 8, 14 & 15 maart</span>
          <div class="details">
            <strong>Groepsexpositie Noordhollandse keramisten</strong>
            <p>Locatie: Warmenhuizen</p>
          </div>
        </li>

        <li class="timeline-item highlight">
          <span class="date">26, 27 & 28 juni</span>
          <div class="details">
            <strong>Kunstparade Heiloo – Expositie eigen werk</strong>
            <p><em>"Keramiek in de achtertuin"</em></p>
          </div>
        </li>

        <li class="timeline-item highlight">
          <span class="date">15 & 16 augustus</span>
          <div class="details">
            <strong>Groepsexpositie Noordhollandse keramisten</strong>
            <p>Locatie: De Rijp</p>
          </div>
        </li>
      </ul>
    </section>

    <section>
        <img src={`/images/P9090526.jpg`} alt="expositie" class="category-card" width="700"/>
    </section>

    <section class="section archive">
      <h2>Eerdere exposities</h2>
      <ul class="timeline">
        <li class="timeline-item">
          <span class="date">2025</span>
          <div class="details">
            <p>2x Groepsexpositie Noordhollandse keramisten (Warmenhuizen en Hensbroek).</p>
            <p>Kunstparade Heiloo: <em>"Keramiek in de achtertuin"</em>.</p>
            <p>Expositie Noordhollandse keramisten in Fort Penningsveer.</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2024</span>
          <div class="details">
            <p>2x Groepsexpositie Noordhollandse keramisten (Warmenhuizen en Zaandijk).</p>
            <p>Kunstparade Heiloo: <em>"Keramiek in de achtertuin"</em>.</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2023</span>
          <div class="details">
            <p>2x Groepsexpositie Noordhollandse keramisten in Warmenhuizen en De Rijp.</p>
            <p>Kunstparade Heiloo: <em>"Keramiek in de achtertuin"</em>.</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2022</span>
          <div class="details">
            <p>2x Groepsexpositie Noordhollandse keramisten en <em>"Keramiek in de achtertuin"</em>.</p>
            <p>Expositie Dorpskerk Grootschermer (6x keramiek en 3x schilderijen).</p>
            <p>OldSkoel Kunstweekend in Burgerbrug.</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2021</span>
          <div class="details">
            <p>Vitrine-expositie in Noordwest Ziekenhuis Alkmaar.</p>
            <p>KerAmiCasa – <em>"25 jaar bezig met klei"</em> (huiskamer-expositie & <em>"Keramiek in de achtertuin"</em>).</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2020</span>
          <div class="details">
            <p>Vitrine-expositie in Bibliotheek Heiloo.</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2010 – 2019</span>
          <div class="details">
            <p><em>"Keramiek in de achtertuin"</em>: jaarlijkse expositie in eigen tuin tijdens de Kunst6daagse/Kunstparade in Heiloo.</p>
            <p>Groepsexposities Noordhollandse keramisten op diverse locaties.</p>
            <p>Deelname aan Open Atelier van de Noordhollandse keramisten.</p>
          </div>
        </li>

        <li class="timeline-item">
          <span class="date">2013 – 2018</span>
          <div class="details">
            <p>Keramiekmarkten in o.a. Dordrecht, Zoetermeer ("Keramiek in 't Park"), Buren ("Blij met klei"), Bergen en Purmerend.</p>
            <p>Exposities bij Keramikos, Galerie De Buitenkans (Heiloo) en Het Trefpunt (Heiloo).</p>
          </div>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .exposities-container {
    max-width: 740px;
    margin: 0 auto;
  }

  h1 {
    font-size: 1.5rem;
    color: var(--heading-color, #ffffff);
    margin-bottom: 25px;
    font-weight: 400;
    border-bottom: 1px solid var(--border-color, #333333);
    padding-bottom: 10px;
  }

  .section {
    margin-bottom: 35px;
  }

  h2 {
    font-size: 1.2rem;
    color: #66b2ff;
    margin-bottom: 18px;
    font-weight: 400;
  }

  .archive h2 {
    color: #ffffff;
    border-bottom: 1px dashed var(--border-color, #333333);
    padding-bottom: 6px;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
    padding: 12px;
    background-color: #141414;
    border: 1px solid var(--border-color, #333333);
    border-radius: 4px;
  }

  .timeline-item.highlight {
    background-color: #1a222d;
    border-color: #2b4c7e;
  }

  .date {
    font-weight: 600;
    color: #ffffff;
    font-size: 0.95rem;
  }

  .details {
    color: var(--text-color, #dddddd);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .details strong {
    color: #ffffff;
    display: block;
    margin-bottom: 2px;
  }

  .details p {
    margin: 0 0 4px 0;
  }

  .details p:last-child {
    margin-bottom: 0;
  }

  .details em {
    color: #aaccff;
  }

  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>