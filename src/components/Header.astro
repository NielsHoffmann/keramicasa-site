---
const base = import.meta.env.BASE_URL; // Geeft '/keramicasa-site/' of '/' terug
const currentPath = Astro.url.pathname;

const navItems = [
  { href: base, label: 'Home' },
  { href: `${base}cv`, label: 'Cv' },
  { href: `${base}exposities`, label: 'Exposities' },
  { href: `${base}fotos`, label: "Foto's" },
  { href: `${base}contact`, label: 'Contact en info' },
];
---
<header>
  <a href={base}>
    <img src={`${base}images/keramicasa.jpg`} alt="KerAmiCasa" class="logo" />
  </a>
</header>

<nav>
  <ul>
    {navItems.map((item) => (
      <li>
        <a 
          href={item.href} 
          class={currentPath === item.href || currentPath === `${item.href}/` ? 'active' : ''}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>